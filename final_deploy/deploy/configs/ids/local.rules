# Демонстрационные правила Suricata для стенда ГИС.
# $HOME_NET = приватные сети стенда (10.0.0.0/8), $EXTERNAL_NET = "интернет" (198.51.100.0/24).

# Внешний доступ к публичным сервисам ДМЗ (основной сценарий детекта)
alert tcp $EXTERNAL_NET any -> $HOME_NET 80 (msg:"GIS: HTTP к сервису ДМЗ из внешней сети"; sid:1000001; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 443 (msg:"GIS: HTTPS к сервису ДМЗ из внешней сети"; sid:1000002; rev:1;)

# Попытка подключения по SSH к узлам стенда
alert tcp any any -> $HOME_NET 22 (msg:"GIS: попытка подключения по SSH"; sid:1000004; rev:1;)

# ICMP только между внешней и приватной сетями (без link-local IPv6-шума)
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"GIS: ICMP из внешней сети"; sid:1000003; rev:1;)
